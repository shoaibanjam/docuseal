<!DOCTYPE html>
<% initial_theme = cookies['cybros-theme'] == 'docuseal-light' ? 'docuseal-light' : 'docuseal-dark' %>
<html data-theme="<%= initial_theme %>" lang="<%= I18n.locale %>" dir="<%= locale_direction %>" data-i18n-failed-to-download-files="<%= t('failed_to_download_files', default: 'Failed to download files') %>" data-i18n-clipboard-unavailable="<%= t('clipboard_unavailable_copy_text', default: "Clipboard not available. Make sure you're using https:// Copy text: %{text}") %>" data-i18n-enter-pdf-password="<%= t('enter_pdf_password', default: 'Enter PDF password') %>" data-i18n-signature-too-small="<%= t('signature_is_too_small_or_simple_please_redraw', default: 'Signature is too small or simple. Please redraw.') %>" data-i18n-confirm-ok="<%= t('confirm_ok', default: 'OK') %>" data-i18n-confirm-cancel="<%= t('cancel', default: 'Cancel') %>">
  <head>
    <%= render 'layouts/head_tags' %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%= csrf_meta_tags %>
    <% if ENV['ROLLBAR_CLIENT_TOKEN'] %>
      <meta name="rollbar-token" content="<%= ENV.fetch('ROLLBAR_CLIENT_TOKEN', nil) %>">
      <%= javascript_pack_tag 'rollbar', 'application', defer: true %>
    <% else %>
      <%= javascript_pack_tag 'application', defer: true %>
    <% end %>
    <%= stylesheet_pack_tag 'application', media: 'all' %>
  </head>
  <body>
    <% unless content_for?(:hide_theme_toggle) %>
      <div class="locale-floating-actions fixed top-4 z-[80] flex items-center gap-2">
        <%= render 'shared/locale_switcher' %>
        <theme-toggle class="inline-flex" data-label-light="<%= t('switch_to_light_mode', default: 'Switch to light mode') %>" data-label-dark="<%= t('switch_to_dark_mode', default: 'Switch to dark mode') %>">
          <button type="button" class="theme-toggle-btn">
            <span data-theme-icon="sun">
              <%= svg_icon('sun', class: 'w-5 h-5') %>
            </span>
            <span data-theme-icon="moon" class="hidden">
              <%= svg_icon('moon', class: 'w-5 h-5') %>
            </span>
          </button>
        </theme-toggle>
      </div>
    <% end %>
    <% if flash.present? %><%= render 'shared/flash' %><% end %>
    <%= yield %>
    <turbo-frame id="modal"></turbo-frame>
  </body>
</html>
