<section id="landing-hero" class="landing-section landing-hero relative overflow-hidden pb-16 pt-0 md:pb-24">
  <div class="pointer-events-none absolute inset-0 landing-hero-aurora" aria-hidden="true">
    <div class="landing-hero-orb landing-hero-orb--a absolute left-1/2 top-0 h-[520px] w-[520px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(4,190,153,0.2),transparent_68%)]"></div>
    <div class="landing-hero-orb landing-hero-orb--b absolute bottom-0 right-0 h-[380px] w-[380px] translate-x-1/4 translate-y-1/4 rounded-full bg-[radial-gradient(circle,rgba(38,203,176,0.16),transparent_70%)]"></div>
    <div class="landing-hero-orb landing-hero-orb--c absolute left-0 top-1/3 h-[280px] w-[280px] -translate-x-1/3 rounded-full bg-[radial-gradient(circle,rgba(128,224,206,0.12),transparent_65%)]"></div>
  </div>

  <div class="landing-hero-layout relative mx-auto max-w-7xl px-6 pt-3 md:pt-6">
    <div class="landing-hero-copy-col w-full min-w-0 text-center lg:text-start" data-aos="<%= rtl_locale? ? 'fade-left' : 'fade-right' %>" data-aos-duration="750">
      <span class="landing-cloud-badge mb-6 inline-flex motion-safe:animate-[landing-badge-pop_0.6s_ease-out_both]"><%= t('landing.hero.badge') %></span>
      <% landing_hero_rotating_words = t('landing.hero.rotating_words') %>
      <h1 class="landing-hero-title text-4xl font-bold text-white md:text-5xl lg:text-6xl <%= rtl_locale? ? '' : 'tracking-tight leading-[1.1]' %>">
        <span class="sr-only">
          <%= localized_product_name %>
          <%= t('landing.hero.headline_sr') %>
        </span>
        <span aria-hidden="true" class="landing-hero-headline<%= ' landing-hero-headline--rtl' if rtl_locale? %>">
          <span class="landing-hero-headline-line block">
            <span class="landing-gradient-text"><%= localized_product_name %></span>
            <%= t('landing.hero.headline_powering') %>
          </span>
          <span class="landing-hero-headline-line landing-hero-headline-line--accent block">
            <%= t('landing.hero.headline_future_of') %> <%= tag.span(
              landing_hero_rotating_words.first,
              id: 'landing-hero-rotating-word',
              class: 'landing-gradient-text landing-hero-rotating-word',
              aria: { live: 'polite' },
              data: {
                landing_rotating_words: landing_hero_rotating_words.to_json
              }
            ) %>
          </span>
          <span class="landing-hero-headline-line block"><%= t('landing.hero.headline_suffix') %></span>
        </span>
      </h1>
      <p class="landing-hero-copy mx-auto mt-6 max-w-xl text-lg text-slate-400 lg:mx-0 <%= rtl_locale? ? '' : 'leading-relaxed' %>">
        <%= t('landing.hero.description') %>
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
        <%= link_to t('landing.hero.cta_primary'), get_started_path, class: 'base-button profile-settings-btn-primary landing-hero-cta' %>
        <a href="#landing-security" class="tpl-show-action-btn tpl-show-action-btn--outline landing-hero-secondary-cta">
          <%= t('landing.hero.cta_secondary') %>
        </a>
      </div>
    </div>

    <div class="landing-hero-media-col w-full min-w-0" data-aos="<%= rtl_locale? ? 'fade-right' : 'fade-left' %>" data-aos-duration="750" data-aos-delay="100">
      <div class="landing-hero-media landing-refined-panel relative mx-auto w-full max-w-[28rem] overflow-hidden rounded-2xl sm:max-w-[30rem] md:max-w-[32rem] lg:mx-0 lg:ms-auto lg:max-w-none">
        <img
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBQdDB4qUgr63aEJrmPO0mWkaKv7yI5yctaXXIgNqQz5HJQflVUMNr16-Wo3TwgUDS2uL62YlVIyEOV2_V48yvn4eJjhVcvNiUP2j7dU7esxEaiusHeC0rYQacvKXQ4VcEjrI5Cehqo6GlTLlMkJD-yQ51VvbFFBLuAVlUhru1TAP__KrjUwHLTox76_CgmlkYUnp6hrBlxy9ple7bhiL_XyVJXuW2M2yXp6_pkXWCwTD9F_bSDSy7auQb5bXjaaV2HSnjgHdmTPRr2"
          alt="<%= t('landing.hero.dashboard_alt') %>"
          class="landing-hero-dashboard-image landing-hero-dashboard-image--dark h-auto w-full"
          loading="lazy"
        >
        <img
          src="/landing/hero-light.png"
          alt="<%= t('landing.hero.preview_alt') %>"
          class="landing-hero-dashboard-image landing-hero-dashboard-image--light h-auto w-full"
          loading="lazy"
        >
        <div class="landing-hero-media-overlay pointer-events-none absolute inset-0"></div>
      </div>
    </div>
  </div>
</section>
