<section id="landing-solutions" class="landing-section landing-solutions-grid py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
      <span class="landing-cloud-badge mx-auto mb-4 inline-block"><%= t('landing.solutions.eyebrow') %></span>
      <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
        <%= t('landing.solutions.title_html') %>
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        <%= t('landing.solutions.description', product: Docuseal.product_name) %>
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% solutions = [
        { icon: 'bolt', title: t('landing.solutions.cards.self_host.title'), copy: t('landing.solutions.cards.self_host.copy') },
        { icon: 'hub', title: t('landing.solutions.cards.api_first.title'), copy: t('landing.solutions.cards.api_first.copy') },
        { icon: 'devices', title: t('landing.solutions.cards.mobile_signing.title'), copy: t('landing.solutions.cards.mobile_signing.copy') },
        { icon: 'shield', title: t('landing.solutions.cards.auditability.title'), copy: t('landing.solutions.cards.auditability.copy') },
        { icon: 'group', title: t('landing.solutions.cards.team_management.title'), copy: t('landing.solutions.cards.team_management.copy') },
        { icon: 'extension', title: t('landing.solutions.cards.integrations.title'), copy: t('landing.solutions.cards.integrations.copy') }
      ] %>
      <% solutions.each_with_index do |item, idx| %>
        <div class="landing-solutions-card landing-refined-card landing-surface-interactive landing-tilt rounded-2xl p-6 transition duration-300" data-aos="zoom-in" data-aos-delay="<%= [idx * 60, 300].min %>" data-aos-duration="600">
          <div class="landing-card-icon mb-4 inline-flex h-11 w-11 items-center justify-center rounded-xl">
            <span class="material-symbols-outlined text-[22px]" style="font-variation-settings: 'FILL' 1, 'wght' 500;"><%= item[:icon] %></span>
          </div>
          <h3 class="text-lg font-semibold text-white"><%= item[:title] %></h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400"><%= item[:copy] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
