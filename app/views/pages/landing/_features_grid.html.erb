<section id="landing-products" class="landing-section landing-features-grid py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
      <span class="landing-cloud-badge mx-auto mb-4 inline-block"><%= t('landing.features.eyebrow') %></span>
      <h2 class="landing-section-title text-3xl font-bold tracking-tight text-white md:text-4xl">
        <%= t('landing.features.title_html') %>
      </h2>
      <p class="mt-4 text-lg text-slate-400">
        <%= t('landing.features.description') %>
      </p>
    </div>

    <div class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% products = [
        { icon: 'domain', title: t('landing.features.cards.template_builder.title'), copy: t('landing.features.cards.template_builder.copy') },
        { icon: 'draw', title: t('landing.features.cards.online_signing.title'), copy: t('landing.features.cards.online_signing.copy') },
        { icon: 'api', title: t('landing.features.cards.api_webhooks.title'), copy: t('landing.features.cards.api_webhooks.copy') },
        { icon: 'groups', title: t('landing.features.cards.multi_recipient.title'), copy: t('landing.features.cards.multi_recipient.copy') },
        { icon: 'mail', title: t('landing.features.cards.email_delivery.title'), copy: t('landing.features.cards.email_delivery.copy') },
        { icon: 'verified', title: t('landing.features.cards.pdf_verification.title'), copy: t('landing.features.cards.pdf_verification.copy') }
      ] %>
      <% products.each_with_index do |p, idx| %>
        <article class="landing-products-card landing-refined-card landing-surface-interactive landing-tilt group flex flex-col rounded-2xl p-8 transition duration-300" data-aos="fade-up" data-aos-delay="<%= [idx * 75, 375].min %>">
          <div class="landing-card-icon mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl">
            <span class="material-symbols-outlined text-[26px]" style="font-variation-settings: 'FILL' 0, 'wght' 400;"><%= p[:icon] %></span>
          </div>
          <h3 class="text-xl font-semibold text-white"><%= p[:title] %></h3>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-400"><%= p[:copy] %></p>
          <a href="#landing-solutions" class="landing-products-link mt-6 inline-flex items-center gap-1 text-sm font-semibold transition group-hover:gap-2">
            <%= t('landing.features.learn_more') %>
            <span aria-hidden="true">→</span>
          </a>
        </article>
      <% end %>
    </div>
  </div>
</section>
